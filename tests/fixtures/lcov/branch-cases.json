{
  "version": 1,
  "cases": [
    {
      "id": "repository-safe-sf-mapping",
      "purpose": "BRDA records are keyed to a repository-safe SF mapping",
      "repoRoot": "/repo",
      "input": "SF:/repo/src/choice.ts\nBRDA:10,0,0,1\nBRDA:10,0,1,0\nend_of_record\n",
      "expected": {
        "outcome": "resolved",
        "observations": [
          { "path": "src/choice.ts", "line": 10, "block_id": "0", "branch_id": "0", "taken": 1, "state": "BRANCH_EXERCISED" },
          { "path": "src/choice.ts", "line": 10, "block_id": "0", "branch_id": "1", "taken": 0, "state": "BRANCH_NOT_EXERCISED" }
        ]
      }
    },
    {
      "id": "numeric-taken-and-unknown-taken",
      "purpose": "unknown taken remains an explicit unresolved branch observation",
      "repoRoot": "/repo",
      "input": "SF:/repo/src/unknown.ts\nBRDA:4,b,0,-\nend_of_record\n",
      "expected": {
        "outcome": "resolved",
        "observations": [
          { "path": "src/unknown.ts", "line": 4, "block_id": "b", "branch_id": "0", "taken": null, "state": "BRANCH_UNRESOLVED", "reason": "LCOV branch taken count is unknown" }
        ]
      }
    },
    {
      "id": "repeated-numeric-aggregation",
      "purpose": "repeated numeric taken values for the same tuple aggregate by safe addition",
      "repoRoot": "/repo",
      "input": "SF:/repo/src/repeat.ts\nBRDA:3,block,branch,2\nend_of_record\nSF:/repo/src/repeat.ts\nBRDA:3,block,branch,3\nend_of_record\n",
      "expected": {
        "outcome": "resolved",
        "observations": [
          { "path": "src/repeat.ts", "line": 3, "block_id": "block", "branch_id": "branch", "taken": 5, "state": "BRANCH_EXERCISED" }
        ]
      }
    },
    {
      "id": "unknown-sticks-through-numeric",
      "purpose": "once unknown, a branch observation stays unresolved even if a later numeric observation appears",
      "repoRoot": "/repo",
      "input": "SF:/repo/src/sticky.ts\nBRDA:5,block,branch,-\nend_of_record\nSF:/repo/src/sticky.ts\nBRDA:5,block,branch,1\nend_of_record\n",
      "expected": {
        "outcome": "resolved",
        "observations": [
          { "path": "src/sticky.ts", "line": 5, "block_id": "block", "branch_id": "branch", "taken": null, "state": "BRANCH_UNRESOLVED", "reason": "LCOV branch taken count is unknown" }
        ]
      }
    },
    {
      "id": "deterministic-ordering",
      "purpose": "observations sort deterministically by path, line, block_id, branch_id using code-unit order",
      "repoRoot": "/repo",
      "input": "SF:/repo/src/z.ts\nBRDA:1,ä,0,1\nBRDA:1,z,0,1\nend_of_record\n",
      "expected": {
        "outcome": "resolved",
        "observations": [
          { "path": "src/z.ts", "line": 1, "block_id": "z", "branch_id": "0", "taken": 1, "state": "BRANCH_EXERCISED" },
          { "path": "src/z.ts", "line": 1, "block_id": "ä", "branch_id": "0", "taken": 1, "state": "BRANCH_EXERCISED" }
        ]
      }
    },
    {
      "id": "fail-closed-outside-source-record",
      "purpose": "a BRDA outside any SF record fails closed",
      "repoRoot": "/repo",
      "input": "BRDA:1,0,0,1\n",
      "expected": {
        "outcome": "unresolved",
        "observations": null,
        "reason": "LCOV branch record is malformed"
      }
    },
    {
      "id": "fail-closed-malformed-source-close",
      "purpose": "an end_of_record without an open SF fails closed",
      "repoRoot": "/repo",
      "input": "end_of_record\nSF:/repo/src/later.ts\nBRDA:1,0,0,1\nend_of_record\n",
      "expected": {
        "outcome": "unresolved",
        "observations": null,
        "reason": "LCOV source record is malformed"
      }
    },
    {
      "id": "fail-closed-incomplete-record",
      "purpose": "a second SF before the first ends fails closed",
      "repoRoot": "/repo",
      "input": "SF:/repo/src/a.ts\nBRDA:1,0,0,1\nSF:/repo/src/b.ts\nBRDA:2,0,0,1\nend_of_record\n",
      "expected": {
        "outcome": "unresolved",
        "observations": null,
        "reason": "LCOV source record is incomplete"
      }
    },
    {
      "id": "fail-closed-malformed-branch-record",
      "purpose": "a malformed BRDA record fails closed",
      "repoRoot": "/repo",
      "input": "SF:/repo/src/bad.ts\nBRDA:not-a-line,0,0,1\nend_of_record\n",
      "expected": {
        "outcome": "unresolved",
        "observations": null,
        "reason": "LCOV branch record is malformed"
      }
    },
    {
      "id": "fail-closed-invalid-taken",
      "purpose": "invalid taken tokens fail closed",
      "repoRoot": "/repo",
      "input": "SF:/repo/src/taken.ts\nBRDA:1,0,0,-1\nend_of_record\n",
      "expected": {
        "outcome": "unresolved",
        "observations": null,
        "reason": "LCOV branch taken count is invalid"
      }
    },
    {
      "id": "fail-closed-empty-block-or-branch",
      "purpose": "empty block or branch identifiers fail closed",
      "repoRoot": "/repo",
      "input": "SF:/repo/src/empty.ts\nBRDA:1,,0,1\nend_of_record\n",
      "expected": {
        "outcome": "unresolved",
        "observations": null,
        "reason": "LCOV branch record is malformed"
      }
    },
    {
      "id": "fail-closed-source-outside-repo",
      "purpose": "a source path outside the repository fails closed",
      "repoRoot": "/repo",
      "input": "SF:/outside/src/escape.ts\nBRDA:9,0,0,1\nend_of_record\n",
      "expected": {
        "outcome": "unresolved",
        "observations": null,
        "reason": "source path cannot be mapped inside the repository"
      }
    },
    {
      "id": "fail-closed-safe-integer-overflow",
      "purpose": "repeated individually valid branch counts that overflow safe integer aggregation fail closed",
      "repoRoot": "/repo",
      "input": "SF:/repo/src/overflow.ts\nBRDA:1,0,0,9007199254740991\nend_of_record\nSF:/repo/src/overflow.ts\nBRDA:1,0,0,1\nend_of_record\n",
      "expected": {
        "outcome": "unresolved",
        "observations": null,
        "reason": "LCOV branch taken count is invalid"
      }
    },
    {
      "id": "no-branch-data",
      "purpose": "a source section with no BRDA records does not invent branch evidence",
      "repoRoot": "/repo",
      "input": "SF:/repo/src/line-only.ts\nDA:1,1\nend_of_record\n",
      "expected": {
        "outcome": "unresolved",
        "observations": null,
        "reason": "no usable branch coverage records"
      }
    },
    {
      "id": "windows-source-mapping",
      "purpose": "Windows absolute source paths map to canonical relative paths",
      "repoRoot": "C:\\repo",
      "input": "SF:C:\\repo\\src\\windows.ts\nBRDA:3,0,0,1\nend_of_record\n",
      "expected": {
        "outcome": "resolved",
        "observations": [
          { "path": "src/windows.ts", "line": 3, "block_id": "0", "branch_id": "0", "taken": 1, "state": "BRANCH_EXERCISED" }
        ]
      }
    }
  ]
}
