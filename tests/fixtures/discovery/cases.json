{
  "version": 1,
  "cases": [
    {
      "id": "explicit-npm",
      "purpose": "valid root packageManager declaration selects npm over a conflicting pnpm lockfile",
      "files": {
        "package.json": "{\n  \"name\": \"fixture-explicit-npm\",\n  \"private\": true,\n  \"packageManager\": \"npm@10.9.2\"\n}\n",
        "pnpm-lock.yaml": "lockfileVersion: '9.0'\n"
      },
      "expected": {
        "packageManager": "npm",
        "workspace": "single",
        "jsTestRunner": null,
        "pytestBasic": false
      }
    },
    {
      "id": "explicit-pnpm",
      "purpose": "valid root packageManager declaration selects pnpm over a conflicting Yarn lockfile",
      "files": {
        "package.json": "{\n  \"name\": \"fixture-explicit-pnpm\",\n  \"private\": true,\n  \"packageManager\": \"pnpm@10.15.0\"\n}\n",
        "yarn.lock": "# This file is generated by Yarn.\n__metadata:\n  version: 8\n"
      },
      "expected": {
        "packageManager": "pnpm",
        "workspace": "single",
        "jsTestRunner": null,
        "pytestBasic": false
      }
    },
    {
      "id": "explicit-yarn",
      "purpose": "valid root packageManager declaration selects yarn over a conflicting npm lockfile",
      "files": {
        "package.json": "{\n  \"name\": \"fixture-explicit-yarn\",\n  \"private\": true,\n  \"packageManager\": \"yarn@4.9.2\"\n}\n",
        "package-lock.json": "{\n  \"name\": \"fixture-explicit-yarn-conflict\",\n  \"lockfileVersion\": 3,\n  \"requires\": true,\n  \"packages\": {}\n}\n"
      },
      "expected": {
        "packageManager": "yarn",
        "workspace": "single",
        "jsTestRunner": null,
        "pytestBasic": false
      }
    },
    {
      "id": "lockfile-only-npm",
      "purpose": "one recognized lockfile selects npm when packageManager is absent",
      "files": {
        "package.json": "{\n  \"name\": \"fixture-lockfile-npm\",\n  \"private\": true\n}\n",
        "package-lock.json": "{\n  \"name\": \"fixture-lockfile-npm\",\n  \"lockfileVersion\": 3,\n  \"requires\": true,\n  \"packages\": {}\n}\n"
      },
      "expected": {
        "packageManager": "npm",
        "workspace": "single",
        "jsTestRunner": null,
        "pytestBasic": false
      }
    },
    {
      "id": "lockfile-only-pnpm",
      "purpose": "one recognized lockfile selects pnpm when packageManager is absent",
      "files": {
        "package.json": "{\n  \"name\": \"fixture-lockfile-pnpm\",\n  \"private\": true\n}\n",
        "pnpm-lock.yaml": "lockfileVersion: '9.0'\n"
      },
      "expected": {
        "packageManager": "pnpm",
        "workspace": "single",
        "jsTestRunner": null,
        "pytestBasic": false
      }
    },
    {
      "id": "lockfile-only-yarn",
      "purpose": "one recognized lockfile selects yarn when packageManager is absent",
      "files": {
        "package.json": "{\n  \"name\": \"fixture-lockfile-yarn\",\n  \"private\": true\n}\n",
        "yarn.lock": "# This file is generated by Yarn.\n__metadata:\n  version: 8\n"
      },
      "expected": {
        "packageManager": "yarn",
        "workspace": "single",
        "jsTestRunner": null,
        "pytestBasic": false
      }
    },
    {
      "id": "ambiguous-lockfiles",
      "purpose": "multiple recognized lockfiles fail closed when packageManager is absent",
      "files": {
        "package.json": "{\n  \"name\": \"fixture-ambiguous-lockfiles\",\n  \"private\": true\n}\n",
        "package-lock.json": "{\n  \"name\": \"fixture-ambiguous-lockfiles\",\n  \"lockfileVersion\": 3,\n  \"requires\": true,\n  \"packages\": {}\n}\n",
        "pnpm-lock.yaml": "lockfileVersion: '9.0'\n"
      },
      "expected": {
        "packageManager": "ambiguous",
        "workspace": "single",
        "jsTestRunner": null,
        "pytestBasic": false
      }
    },
    {
      "id": "single-basic-vitest",
      "purpose": "single-package JS project exposes one supported Vitest runner",
      "files": {
        "package.json": "{\n  \"name\": \"fixture-single-vitest\",\n  \"private\": true,\n  \"packageManager\": \"npm@10.9.2\",\n  \"scripts\": {\n    \"test\": \"vitest run\"\n  },\n  \"devDependencies\": {\n    \"vitest\": \"4.1.10\"\n  }\n}\n",
        "package-lock.json": "{\n  \"name\": \"fixture-single-vitest\",\n  \"lockfileVersion\": 3,\n  \"requires\": true,\n  \"packages\": {}\n}\n",
        "vitest.config.ts": "export default {};\n",
        "src/example.ts": "export const example = 1;\n",
        "tests/example.test.ts": "export {};\n"
      },
      "expected": {
        "packageManager": "npm",
        "workspace": "single",
        "jsTestRunner": "vitest",
        "pytestBasic": false
      }
    },
    {
      "id": "basic-workspace-jest",
      "purpose": "basic workspace layout remains explicit while one supported Jest runner is discoverable",
      "files": {
        "package.json": "{\n  \"name\": \"fixture-workspace-jest\",\n  \"private\": true,\n  \"packageManager\": \"npm@10.9.2\",\n  \"workspaces\": [\"packages/*\"],\n  \"devDependencies\": {\n    \"jest\": \"30.0.0\"\n  }\n}\n",
        "package-lock.json": "{\n  \"name\": \"fixture-workspace-jest\",\n  \"lockfileVersion\": 3,\n  \"requires\": true,\n  \"packages\": {}\n}\n",
        "jest.config.js": "export default {};\n",
        "packages/app/package.json": "{\n  \"name\": \"fixture-workspace-app\",\n  \"private\": true,\n  \"scripts\": {\n    \"test\": \"jest\"\n  }\n}\n",
        "packages/app/src/example.js": "export const example = 1;\n"
      },
      "expected": {
        "packageManager": "npm",
        "workspace": "basic",
        "jsTestRunner": "jest",
        "pytestBasic": false
      }
    },
    {
      "id": "ambiguous-vitest-jest",
      "purpose": "a scope exposing both supported JS runners fails closed instead of creating two workflows",
      "files": {
        "package.json": "{\n  \"name\": \"fixture-ambiguous-runners\",\n  \"private\": true,\n  \"packageManager\": \"npm@10.9.2\",\n  \"devDependencies\": {\n    \"jest\": \"30.0.0\",\n    \"vitest\": \"4.1.10\"\n  }\n}\n",
        "package-lock.json": "{\n  \"name\": \"fixture-ambiguous-runners\",\n  \"lockfileVersion\": 3,\n  \"requires\": true,\n  \"packages\": {}\n}\n",
        "jest.config.js": "export default {};\n",
        "vitest.config.ts": "export default {};\n"
      },
      "expected": {
        "packageManager": "npm",
        "workspace": "single",
        "jsTestRunner": "ambiguous",
        "pytestBasic": false
      }
    },
    {
      "id": "pytest-basic-clear",
      "purpose": "clearly configured pytest is represented separately from JS runner discovery",
      "files": {
        "pyproject.toml": "[tool.pytest.ini_options]\ntestpaths = [\"tests\"]\n",
        "tests/test_example.py": "def test_example():\n    assert True\n"
      },
      "expected": {
        "packageManager": null,
        "workspace": "single",
        "jsTestRunner": null,
        "pytestBasic": true,
        "pytestConfig": "pyproject.toml"
      }
    },
    {
      "id": "unsupported-mocha-only",
      "purpose": "unsupported JS runners are not mislabeled as supported Vitest or Jest discovery",
      "files": {
        "package.json": "{\n  \"name\": \"fixture-mocha-only\",\n  \"private\": true,\n  \"packageManager\": \"npm@10.9.2\",\n  \"devDependencies\": {\n    \"mocha\": \"11.7.1\"\n  }\n}\n",
        "package-lock.json": "{\n  \"name\": \"fixture-mocha-only\",\n  \"lockfileVersion\": 3,\n  \"requires\": true,\n  \"packages\": {}\n}\n"
      },
      "expected": {
        "packageManager": "npm",
        "workspace": "single",
        "jsTestRunner": null,
        "pytestBasic": false
      }
    }
  ]
}
