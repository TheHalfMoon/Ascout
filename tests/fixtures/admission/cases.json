    {
      "id": "package-script-typecheck-changed",
      "purpose": "A changed package.json script used for typecheck is command authority and must refuse before launch.",
      "task": "typecheck",
      "files": {
        "package.json": "{\"name\":\"fixture\",\"scripts\":{\"typecheck\":\"tsc -p tsconfig.json --noEmit\"}}",
        "tsconfig.json": "{\"compilerOptions\":{\"strict\":true}}\n",
        "src/index.ts": "export const value = 1;\n"
      },
      "effectiveAuthorityPaths": ["package.json"],
      "changedPaths": ["package.json"],
      "executionLoadPaths": [],
      "expected": {
        "command_surface_changed": true,
        "changed_authority_paths": ["package.json"],
        "execution_admission": "refused_changed_surface",
        "launch_allowed": false,
        "status": "NOT_RUN",
        "reason_code": "command_surface_changed",
        "effective_pytest_config": null
      }
    },
