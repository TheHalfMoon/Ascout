{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascout:receipt:v1",
  "title": "Ascout Verification Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "source",
    "comparison",
    "selection",
    "tasks",
    "changed_code",
    "exercise",
    "test_changes",
    "findings",
    "artifacts",
    "stability",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run": {"$ref": "#/$defs/run"},
    "source": {"$ref": "#/$defs/source"},
    "comparison": {"$ref": "#/$defs/comparison"},
    "selection": {"$ref": "#/$defs/selection"},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}},
    "changed_code": {"$ref": "#/$defs/changedCode"},
    "exercise": {"$ref": "#/$defs/exercise"},
    "test_changes": {"type": "array", "items": {"$ref": "#/$defs/testChange"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "stability": {"enum": ["stable", "tree_drifted", "unknown"]},
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "ascout_version", "started_at", "finished_at", "config_digest"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "ascout_version": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "config_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "repository_id_kind",
        "portable",
        "head_sha",
        "detached",
        "shallow",
        "tree_digest_version",
        "tree_digest",
        "tracked_index_entry_count",
        "unstaged_changed_count",
        "included_untracked_count"
      ],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "repository_id_kind": {"enum": ["remote", "local_only"]},
        "portable": {"type": "boolean"},
        "head_sha": {"type": ["string", "null"]},
        "detached": {"type": "boolean"},
        "shallow": {"type": "boolean"},
        "tree_digest_version": {"const": 1},
        "tree_digest": {"$ref": "#/$defs/sha256"},
        "tracked_index_entry_count": {"type": "integer", "minimum": 0},
        "unstaged_changed_count": {"type": "integer", "minimum": 0},
        "included_untracked_count": {"type": "integer", "minimum": 0}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"$ref": "#/$defs/sourceState"},
        "end": {
          "oneOf": [
            {"$ref": "#/$defs/sourceState"},
            {"type": "null"}
          ]
        }
      }
    },
    "changedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "change_kind",
        "line_semantics",
        "changed_new_line_ranges",
        "is_test_file",
        "is_snapshot",
        "is_command_surface"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "previous_path": {"type": "string", "minLength": 1},
        "change_kind": {"enum": ["added", "modified", "deleted", "renamed", "type_changed", "untracked"]},
        "line_semantics": {"enum": ["text", "binary_or_non_line", "deleted_only"]},
        "changed_new_line_ranges": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "integer", "minimum": 1},
              {"type": "integer", "minimum": 1}
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "is_test_file": {"type": "boolean"},
        "is_snapshot": {"type": "boolean"},
        "is_command_surface": {"type": "boolean"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "base_ref",
        "includes_staged",
        "includes_unstaged",
        "includes_untracked_nonignored",
        "changed_files"
      ],
      "properties": {
        "kind": {"const": "working_tree_vs_head"},
        "base_ref": {"type": "string", "minLength": 1},
        "includes_staged": {"const": true},
        "includes_unstaged": {"const": true},
        "includes_untracked_nonignored": {"const": true},
        "changed_files": {"type": "array", "items": {"$ref": "#/$defs/changedFile"}}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "widened", "widen_triggers", "passes", "limitations"],
      "properties": {
        "mode": {"enum": ["full", "native_related", "native_changed", "configured", "no_test_task"]},
        "initial_scope": {},
        "selected_test_count": {"type": ["integer", "null"], "minimum": 0},
        "deselected_test_count": {"type": ["integer", "null"], "minimum": 0},
        "total_test_count": {"type": ["integer", "null"], "minimum": 0},
        "widened": {"type": "boolean"},
        "widen_triggers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "passes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2,
          "items": {"type": "object"}
        },
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs", "failures"],
      "properties": {
        "runs": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_type",
        "authorized_by",
        "source_path",
        "argv",
        "argv_redacted",
        "tool_name",
        "tool_version",
        "status",
        "reason_code",
        "reason_text",
        "exit_code",
        "started_at",
        "finished_at",
        "duration_ms",
        "observations",
        "cache_state",
        "evidence_ids",
        "artifact_refs",
        "output_truncated"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "task_type": {"type": "string", "minLength": 1},
        "authorized_by": {"enum": ["user_config", "repo_config", "discovery"]},
        "source_path": {"type": ["string", "null"]},
        "argv": {"type": "array", "items": {"type": "string"}},
        "argv_redacted": {"type": "boolean"},
        "tool_name": {"type": ["string", "null"]},
        "tool_version": {"type": ["string", "null"]},
        "status": {"enum": ["PASS", "FAIL", "FLAKY", "BLOCKED", "ERROR", "NOT_APPLICABLE", "NOT_RUN"]},
        "reason_code": {"type": ["string", "null"]},
        "reason_text": {"type": ["string", "null"]},
        "exit_code": {"type": ["integer", "null"]},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "finished_at": {"type": ["string", "null"], "format": "date-time"},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "observations": {"$ref": "#/$defs/observations"},
        "cache_state": {"enum": ["cold", "warm", "reused", "unknown", "not_applicable"]},
        "selected_test_count": {"type": ["integer", "null"], "minimum": 0},
        "deselected_test_count": {"type": ["integer", "null"], "minimum": 0},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "artifact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "output_truncated": {"type": "boolean"}
      }
    },
    "exerciseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "state", "execution_count", "source_task_ids"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "state": {"enum": ["EXERCISED", "NOT_EXERCISED", "UNRESOLVED"]},
        "execution_count": {"type": ["integer", "null"], "minimum": 0},
        "source_task_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string"}
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_executable_lines",
        "exercised_lines",
        "not_exercised_lines",
        "unresolved_lines",
        "changed_files_with_zero_exercised_lines",
        "records"
      ],
      "properties": {
        "changed_executable_lines": {"type": "integer", "minimum": 0},
        "exercised_lines": {"type": "integer", "minimum": 0},
        "not_exercised_lines": {"type": "integer", "minimum": 0},
        "unresolved_lines": {"type": "integer", "minimum": 0},
        "changed_files_with_zero_exercised_lines": {"type": "integer", "minimum": 0},
        "records": {"type": "array", "items": {"$ref": "#/$defs/exerciseRecord"}}
      }
    },
    "changedCode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_file_count", "changed_text_line_count"],
      "properties": {
        "changed_file_count": {"type": "integer", "minimum": 0},
        "changed_text_line_count": {"type": "integer", "minimum": 0}
      }
    },
    "testChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "source"],
      "properties": {
        "kind": {"enum": ["test_file_changed", "test_file_deleted", "snapshot_changed", "snapshot_deleted"]},
        "path": {"type": "string", "minLength": 1},
        "previous_path": {"type": "string", "minLength": 1},
        "source": {"const": "git_diff"}
      }
    },
    "introducedByChange": {
      "oneOf": [
        {"type": "boolean"},
        {"const": "unknown"}
      ]
    },
    "fingerprintVersion": {
      "oneOf": [
        {"const": 1},
        {"type": "null"}
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "task_id",
        "producer",
        "message",
        "severity",
        "in_changed_lines",
        "introduced_by_change",
        "determinism_class",
        "observations",
        "reproduced",
        "evidence_ids"
      ],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "minLength": 1},
        "rule_or_test_id": {"type": ["string", "null"]},
        "message": {"type": "string"},
        "path": {"type": ["string", "null"]},
        "line_start": {"type": ["integer", "null"], "minimum": 1},
        "line_end": {"type": ["integer", "null"], "minimum": 1},
        "severity": {"enum": ["info", "low", "medium", "high", "critical", "unknown"]},
        "in_changed_lines": {"type": ["boolean", "null"]},
        "introduced_by_change": {"$ref": "#/$defs/introducedByChange"},
        "determinism_class": {"enum": ["deterministic", "nondeterministic", "unknown"]},
        "observations": {"$ref": "#/$defs/observations"},
        "reproduced": {"enum": [true, false, "not_applicable", "unknown"]},
        "fingerprint_version": {"$ref": "#/$defs/fingerprintVersion"},
        "fingerprint": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "relative_run_path", "kind", "sha256", "byte_length", "redacted", "truncated"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "task_id": {"type": ["string", "null"]},
        "relative_run_path": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 0},
        "redacted": {"type": "boolean"},
        "truncated": {"type": "boolean"}
      }
    },
    "taskStatusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PASS", "FAIL", "FLAKY", "BLOCKED", "ERROR", "NOT_APPLICABLE", "NOT_RUN"],
      "properties": {
        "PASS": {"type": "integer", "minimum": 0},
        "FAIL": {"type": "integer", "minimum": 0},
        "FLAKY": {"type": "integer", "minimum": 0},
        "BLOCKED": {"type": "integer", "minimum": 0},
        "ERROR": {"type": "integer", "minimum": 0},
        "NOT_APPLICABLE": {"type": "integer", "minimum": 0},
        "NOT_RUN": {"type": "integer", "minimum": 0}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_status_counts", "finding_count", "completeness", "exit_code"],
      "properties": {
        "task_status_counts": {"$ref": "#/$defs/taskStatusCounts"},
        "finding_count": {"type": "integer", "minimum": 0},
        "completeness": {"enum": ["complete", "materially_incomplete", "unknown_due_to_error"]},
        "exit_code": {"enum": [0, 1, 2, 3, 4]}
      }
    }
  }
}
